{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$HOME/.codex/hooks/pre_tool_use_content_guard.ps1\"",
            "commandWindows": "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:USERPROFILE/.codex/hooks/pre_tool_use_content_guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "위험 콘텐츠 검사 중"
          }
        ]
      }
    ]
  }
}
